# Console: Next.js standalone-ish build; proxies /api/bot to BOT_API_URL.
FROM node:22-slim AS build
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM node:22-slim
WORKDIR /app
COPY --from=build /src/frontend ./
ENV PORT=3000 NODE_ENV=production
EXPOSE 3000
CMD ["npm", "run", "start"]
