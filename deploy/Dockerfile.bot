# Bot: build with the repo's locked Rust, run beside anvil.
FROM rust:1.79-slim AS build
WORKDIR /src/bot
COPY bot/Cargo.toml bot/Cargo.lock ./
COPY bot/crates ./crates
RUN cargo build --release --bin mev-bot

FROM ghcr.io/foundry-rs/foundry:latest AS foundry

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
COPY --from=foundry /usr/local/bin/anvil /usr/local/bin/anvil
COPY --from=build /src/bot/target/release/mev-bot /usr/local/bin/mev-bot
# Data (SQLite) lives on a volume: /data
VOLUME ["/data"]
ENV DB_PATH=/data/mev.sqlite
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD curl -sf http://127.0.0.1:8080/api/health || exit 1
ENTRYPOINT ["/usr/local/bin/mev-bot"]
