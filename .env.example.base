# ─────────────────────────────────────────────────────────────────────────────
# BASE (chain 8453) — shadow-instrument defaults
#
# Copy to the Base instance's env file (/etc/jerseymikes/base.env) and fill
# the RPC URLs. This instance is a second mev-bot process alongside the
# mainnet one (see docs/DEPLOYMENT.md "Multi-chain layout"). Every address
# below is verified live 2026-08-23 (see the ⚠ notes in
# bot/crates/mev-bot/src/config.rs::known for which checks each passed);
# any of them can be overridden with the *_ADDRESS env vars — the built-in
# profile is a convenience, not a requirement.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — a Base RPC with archive state (paid tier recommended; public
# endpoints rate-limit the fork + discovery + per-block pool reads).
BASE_HTTP_URL=
# Legacy alias accepted when BASE_HTTP_URL is unset: ETH_HTTP_URL=
# Base has no public mempool: there is nothing to subscribe to on a WS
# endpoint for pending transactions. Leave unset (the bot falls back to
# head polling) or point SEQUENCER_FEED_URL at the sequencer/preconf feed
# your provider offers (open question R1 in the Base work order — validate
# the feed shape first; the parser accepts full tx objects).
BASE_WS_URL=
# Legacy alias accepted when BASE_WS_URL is unset: ETH_WS_URL=
# SEQUENCER_FEED_URL=

# Flashblocks preconfirmation stream — the highest-resolution feed Base has,
# and the reason this instance can back-run at all. Base seals a preconfirmed
# sub-block every 200 ms, ten per 2 s block, and the flashblock diff carries
# RAW SIGNED transaction bytes; a bundle needs exactly those bytes to transport
# a dependency it wants to back-run. newHeads only fires at the 2 s boundary,
# so this is a 10x resolution difference on the one axis that decides whether
# a backrun is early or late.
#
# Raw websocket, eth_subscribe ["newFlashblocks"]. Requires a
# Flashblocks-integrated provider — a stock Base RPC rejects the subscription,
# and the bot logs the rejection and reconnects with backoff rather than
# failing. Transactions from this feed are TxSource::Flashblock, which is
# backrun_only(): the preconfirmation is already sealed, so nothing can be
# placed ahead of it, and the engine refuses to try.
# FLASHBLOCKS_WS_URL=wss://<your-base-flashblocks-endpoint>

# ── chain ────────────────────────────────────────────────────────────────────
CHAIN_ID=8453
CHAIN_NAME=base
# Base blocks are ~2 s (Flashblocks-era sub-blocks make it faster still).
BLOCK_TIME_MS=2000
# Registry provides WETH (0x4200…0006) + USDC-native (0x8335…2913) for
# chain 8453; override here if your strategy set needs a different anchor.
# WETH_ADDRESS=
# USD_STABLE_ADDRESS=

# ── execution transport ──────────────────────────────────────────────────────
# Base has no relay/builder market. The bot signs exact-payload bundles and
# sends the transactions raw to the RPC with a priority fee (SUBMISSION_MODE
# defaults to 'raw' on chain 8453 — set explicitly if you ever point this
# instance at a chain with relays).
SUBMISSION_MODE=raw
# Base's ordering currency. 1 gwei is the simulated-leg default; re-derive
# from shadow-week inclusion data before any live talk (work order R7).
# PRIORITY_FEE_WEI=1000000000
# Raw cancellation replaces the original nonce with a self-transfer. Both
# original fee caps are bumped by 12.5%, the current base fee is covered, and
# the replacement is refused if it would exceed this hard max-fee cap.
# RAW_CANCEL_BUMP_BPS=1250
# RAW_CANCEL_MAX_FEE_WEI=500000000000
# No relays to call bundle-cancellation on: 'eth_cancelBundle' is a no-op in
# raw mode; cancellation is a same-nonce replacement tx. Leave both empty.
BUNDLE_RELAY_URLS=
# The bloXroute Max Profit relay covers mainnet only — inert on Base.
RELAY_TX_INGEST=false
# Flashbots MEV-Share (mainnet endpoint) — off on Base.
# MEV_SHARE_SSE_URL=

# ── contract ─────────────────────────────────────────────────────────────────
# Deploy MevExecutor on Base (same bytecode as mainnet; the constructor
# takes the Balancer vault — the registry's 0xBA12…BF2C8 is the Base vault,
# same address as mainnet — and Base WETH). Leave empty in shadow mode:
# the simulator injects the fixture into the fork, no deployment needed.
EXECUTOR_ADDRESS=
SEARCHER_PRIVATE_KEY=
# FLASHBOTS_SIGNER_KEY=   (irrelevant in raw mode; no relay headers)
# DEPLOYER_PRIVATE_KEY=   (deploy only; delete after)

# ── risk — Base-scale defaults (re-derive from shadow data) ──────────────────
# Gas is ~10⁻⁴× mainnet: a 0.1% edge that is dead on mainnet is alive here.
MIN_NET_PROFIT_WEI=1
MAX_POSITION_WEI=100000000000000000000
MAX_BASE_FEE_WEI=500000000000
# No builder auction → no bribe. The coinbase transfer would just donate
# to the sequencer fee vault; landing power comes from PRIORITY_FEE_WEI.
BRIBE_BPS=0
MAX_GAS_PER_BUNDLE=3000000
MAX_DRAWDOWN_WEI=0
MAX_INFLIGHT_PER_STRATEGY=32

# ── non-native profit valuation ──────────────────────────────────────────────
# A liquidation is paid in seized collateral, not ETH. Without pricing, the
# simulator's balance-delta accounting nets it to zero and the bundle can never
# clear MIN_NET_PROFIT_WEI. With this on, the non-native delta is priced at the
# pinned pre-bundle fork block via V3 QuoterV2 (fee tiers 100/500/3000/10000)
# then V2 reserves, and fails closed — no route means no value means no bid.
#
# Base note: quote depth is thinner than mainnet and the pool set is smaller,
# so a larger haircut is the honest setting here. Verify against shadow data
# before trusting a valuation on a long-tail Base collateral.
# TOKEN_VALUATION=false
# VALUATION_HAIRCUT_BPS=200

# ── strategies — measurement scope ───────────────────────────────────────────
# Atomic arb prices the block-tick venue graph. Base has one registered V2
# venue, so the pending-tx cross-venue backrun still emits nothing on V2
# alone — but the block-tick mixed search (DEX_UNIV3_ARB and/or
# DEX_AERODROME_ARB below) covers V3↔V2 and Aerodrome↔any cycles from the
# discovered pool sets. Keep shadow-only until the Base revenue-path work
# order's qualification evidence exists.
STRATEGY_ATOMIC_ARB=true
# Front-run strategies: Base has no public mempool — they can only act on
# sequencer-feed txs, which are back-run-only (no signed victim bytes) and
# self-reject. Off by default; the boot warns if you turn them on.
STRATEGY_SANDWICH=false
STRATEGY_SANDWICH_V3=false
STRATEGY_JIT=false
STRATEGY_SNIPER=false
# Lending-protocol liquidations: Aave V3 / Morpho Blue DO exist on Base,
# but the v1 registry deliberately leaves them unregistered (phase 2,
# work order §7). The strategies skip at construction with a boot warning.
STRATEGY_LIQUIDATION=false
STRATEGY_LIQUIDATION_COMPOUND=false
STRATEGY_LIQUIDATION_MORPHO=false
STRATEGY_LIQUIDATION_MAKER=false
# Base's oracle-update front-run: point ORACLE_WATCH_FEEDS at the Base
# Chainlink aggregators you trust before enabling.
STRATEGY_ORACLE_FRONTRUN=false
# ORACLE_WATCH_FEEDS=

# ── pool discovery ───────────────────────────────────────────────────────────
POOL_DISCOVERY=true
POOL_DISCOVERY_V3=true
# V3 legs in atomic_arb (QuoterV2-quoted). Off until you want the
# mixed-venue surface measured; the V2-only search is unchanged.
# DEX_UNIV3_ARB=false
# Aerodrome volatile legs in atomic_arb (work order WS-P): per-pool fee from
# factory.getFee(pool, false), exact fee-off-input integer math (verified
# against router.getAmountOut live), execution via the router's Route[]
# calldata. This is the venue that makes Base cross-venue arb reachable at
# all — the chain has exactly one registered V2 factory. Creation-log
# discovery for the venue joins the POOL_DISCOVERY cadence while this is on.
# Off by default; flip only with the Base shadow plan.
# DEX_AERODROME_ARB=false
# Reserved dark flag (work order P4): Aerodrome stable pools. Stable pricing
# is not implemented — pools refuse to quote until it lands — so this flag
# currently guards nothing and exists for operator-surface parity only.
# DEX_AERODROME_STABLE=false
# 3 legs is the mainnet default; each extra leg costs ~120k gas (cheap on
# Base) — raise only with shadow-funnel evidence.
# ARB_MAX_CYCLE_LEN=3

# ── simulation ───────────────────────────────────────────────────────────────
ANVIL_BIN=anvil
ANVIL_PORT=8548
ANVIL_REPLAY_PORT=8549
# Registry default for chain 8453: refork every 6 blocks (~12 s wall clock)
# instead of every block — a per-block refork on a 2 s chain is 6× the
# mainnet refork rate for no benefit.
# REFORK_EVERY_BLOCKS=6
USE_CALL_BUNDLE=false
TARGET_BLOCK_OFFSET=1
SIM_TIMEOUT_MS=2500

# ── API / storage ────────────────────────────────────────────────────────────
# Second instance: its own port and its own database (per-chain
# qualification clock, smoke budget and kill switch by construction).
API_BIND=127.0.0.1:8081
# API_AUTH_TOKEN=
# Safe local default: resolved from the bot/ working directory, so a
# non-root developer can `make bot-run-base` immediately (make setup creates
# bot/data/ mode 0700). For a managed service, provisioning owns the state
# directory instead — `sudo install -d -o <service-user> -g <service-group>
# -m 700 /var/lib/jerseymikes` — and the deployed env file points at
# DB_PATH=/var/lib/jerseymikes/base.sqlite explicitly. Never run the binary
# with sudo to work around a missing directory: that leaves root-owned
# state and encourages unsafe key handling.
DB_PATH=data/base.sqlite
RUST_LOG=info,mev_bot=debug

# Optional manual-trade fee architecture (public addresses only in frontend).
PLATFORM_FEE_RECIPIENT=
NEXT_PUBLIC_PLATFORM_FEE_RECIPIENT=
NEXT_PUBLIC_PLATFORM_FEE_ROUTER_ADDRESS=

# ── execution / qualification — fail-closed ──────────────────────────────────
BROADCAST_ENABLED=false
LIVE_EXECUTION=false
I_UNDERSTAND_LIVE_RISK=no
# LIVE_SMOKE_MAX=0
# Raw smoke additionally requires a durable worst-case wei exposure cap.
# Each attempted unqualified send reserves sum(gasLimit × maxFeePerGas) from
# this budget before broadcast; zero keeps raw smoke disabled.
# LIVE_SMOKE_MAX_GAS_COST_WEI=0
# Qualification on a sequencer chain compares the fork against independently
# recorded canonical state transitions, not a relay. Actual route matches are
# a separate evidence population and are never counted twice. Atomic arb stays
# unqualified until the successor work order adds its state-comparison rows.
QUALIFICATION_BACKEND=sequencer
# QUALIFICATION_HOURS=168
# QUALIFICATION_MIN_SAMPLES=30
# QUALIFICATION_MIN_RELAY_COMPARISONS=30
# QUALIFICATION_MIN_ACTUAL_MATCHES=30
# QUALIFICATION_MAX_ERROR_BPS=2000
# QUALIFICATION_MIN_ACCURACY_BPS=8000
# QUALIFICATION_MAX_GAP_SECS=120
# FINALITY_DEPTH=12

# ── directional sniper lane (independent from the atomic engine) ─────────────
# Leave all three at their safe defaults until shadow evidence is complete.
SNIPER_VAULT_ADDRESS=
SNIPER_SEARCHER_ADDRESS=
SNIPER_SEARCHER_PRIVATE_KEY=
SNIPER_DIRECTIONAL=false
SNIPER_BUY_SIZE_WEI=0
SNIPER_DAILY_BUDGET_WEI=0
SNIPER_TAKE_PROFIT_BPS=10000
SNIPER_TAKE_PROFIT_ABS_WEI=0
SNIPER_SELL_FRACTION_BPS=10000
SNIPER_STOP_LOSS_BPS=5000
SNIPER_TRAILING_STOP_BPS=0
SNIPER_MAX_HOLD_SECS=1800
SNIPER_MAX_CONCURRENT_POSITIONS=1
SNIPER_TOTAL_BUDGET_WEI=0
SNIPER_MAX_DRAWDOWN_WEI=0
SNIPER_REQUIRE_HONEYPOT_PASS=true
SNIPER_MAX_BUY_TAX_BPS=500
SNIPER_MAX_SELL_TAX_BPS=500
SNIPER_MIN_LIQUIDITY_WEI=2000000000000000000
SNIPER_MAX_PRICE_IMPACT_BPS=300
SNIPER_MIN_HOLD_BLOCKS=1
SNIPER_REQUIRE_LP_LOCKED=false
