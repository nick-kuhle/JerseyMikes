# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# Archive-capable Ethereum mainnet RPC (Alchemy / QuickNode / Erigon / Reth …).
# Needs eth_call at historical blocks and, ideally, eth_getRawTransactionByHash.
ETH_HTTP_URL=

# Websocket endpoint for newHeads + newPendingTransactions.
# Without it the bot falls back to HTTP head polling and sees no mempool.
ETH_WS_URL=

# ─────────────────────────────────────────────────────────────────────────────
# DATA SOURCES (all optional — the bot degrades gracefully)
# ─────────────────────────────────────────────────────────────────────────────

MEV_SHARE_SSE_URL=https://mev-share.flashbots.net
FLASHBOTS_RELAY_URL=https://relay.flashbots.net
RELAY_DATA_URLS=https://boost-relay.flashbots.net,https://bloxroute.max-profit.blxrbdn.com,https://agnostic-relay.net

# Extra mempool websockets (bloXroute, Blocknative, your own node…), comma separated.
EXTRA_MEMPOOL_WS=

# bloXroute Max Profit relay: pull each delivered block's transactions and score
# them for extractable value. Read-only (polls a public data API + your RPC).
BLOXROUTE_MAX_PROFIT_URL=https://bloxroute.max-profit.blxrbdn.com
RELAY_TX_INGEST=true

# How many delivered-block transactions are scored concurrently. A mainnet
# block carries ~150-200 transactions and each fans out to one task per
# strategy, so an unbounded backfill queues ~1000 tasks and a matching burst of
# RPC every 12s — enough to starve the live mempool path and trip provider rate
# limits. Replay work has no deadline (the block is already mined), so it runs
# behind this bound. Raise it only if your RPC has headroom to spare.
# RELAY_TX_CONCURRENCY=16

# Dedicated anvil fork for replaying delivered blocks. Delivered transactions
# are already mined, so they are simulated at the PARENT of the block they
# landed in (block - 1) — the state they actually executed against. That fork
# has to sit at a historical height while the live fork tracks the head, so the
# two cannot be the same instance: sharing one would reset it back and forth on
# every alternating simulation (seconds of refork each way) and block the
# mempool path behind it.
#
# With REPLAY_FORK=false, delivered-block opportunities are still recorded but
# are NOT simulated. That is deliberate: scoring them on the live fork would
# measure them against a state they never ran in and report it as a result.
# REPLAY_FORK=true
# ANVIL_REPLAY_PORT=8549

# L2 sequencer / preconfirmation feed. Used when chain #2 lands.
SEQUENCER_FEED_URL=

# Searcher identity for Flashbots. Only used to sign the X-Flashbots-Signature
# header on read-only eth_callBundle requests — it never needs funds.
FLASHBOTS_SIGNER_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# CHAIN
# ─────────────────────────────────────────────────────────────────────────────

CHAIN_ID=1
CHAIN_NAME=ethereum
BLOCK_TIME_MS=12000
WETH_ADDRESS=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
USD_STABLE_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# ─────────────────────────────────────────────────────────────────────────────
# CONTRACTS
# ─────────────────────────────────────────────────────────────────────────────

# Deployed MevExecutor. Leave empty to have the simulator inject the bytecode
# into its anvil fork at 0x…0e0000 (no deployment required to simulate).
EXECUTOR_ADDRESS=
SEARCHER_ADDRESS=0x00000000000000000000000000000000000f0000

# Only needed for `forge script script/Deploy.s.sol --broadcast`.
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# RISK — deliberately liberal to start. Tighten once the data says what works.
# ─────────────────────────────────────────────────────────────────────────────

# 1 wei == "record anything that is not a loss".
MIN_NET_PROFIT_WEI=1
# 100 ETH of notional per bundle.
MAX_POSITION_WEI=100000000000000000000
MAX_BASE_FEE_WEI=500000000000
# Share of gross profit paid to the builder (90%).
BRIBE_BPS=9000
MAX_GAS_PER_BUNDLE=3000000
# 0 disables the cumulative-drawdown kill switch.
MAX_DRAWDOWN_WEI=0
MAX_INFLIGHT_PER_STRATEGY=32

# ─────────────────────────────────────────────────────────────────────────────
# STRATEGIES
# ─────────────────────────────────────────────────────────────────────────────

STRATEGY_SANDWICH=true
# V3 sandwich via QuoterV2. On after the funnel week, paired with
# POOL_DISCOVERY_V3. Watch live sandwich_v3.candidatesEmitted / submittable
# and /api/latency stage `strategy` p95 (budget: ≤ 25 ms added on the
# pending path; ≤ 12 QuoterV2 eth_calls per candidate). See
# docs/STRATEGIES.md §1b and docs/PHASE_2_HANDOFF.md W5.
STRATEGY_SANDWICH_V3=true
STRATEGY_JIT=true
STRATEGY_ATOMIC_ARB=true
STRATEGY_LIQUIDATION=true
# Compound V3 (Comet): absorb underwater accounts and buy the discounted
# collateral from the storefront in one batch. Block-cadence; ~1 eth_getLogs
# + one batched isLiquidatable sweep per block over a capped watchlist.
STRATEGY_LIQUIDATION_COMPOUND=true
# Morpho Blue: full-close liquidations on actively-traded (loan, collateral)
# whitelisted markets. Markets self-seed from Supply/Borrow activity logs.
STRATEGY_LIQUIDATION_MORPHO=true
# Maker: bark + atomic clip take (ETH-A by default). Each additional ilk adds
# one frob-log scan and a batched urn poll.
STRATEGY_LIQUIDATION_MAKER=true
# Oracle-update front-running: watch Chainlink transmits and Maker OSM pokes
# in the mempool and back-run them with near-miss liquidations.
STRATEGY_ORACLE_FRONTRUN=true
STRATEGY_SNIPER=true

# ─────────────────────────────────────────────────────────────────────────────
# LIQUIDATION COVERAGE (Compound V3 / Morpho Blue / Maker)
# ─────────────────────────────────────────────────────────────────────────────

# Max accounts polled per protocol per block (evicts least-recently-active).
# LIQUIDATION_WATCH_CAP=200

# Morpho market/borrower tracking caps. Markets are the most recently active
# ones discovered from activity logs; only whitelisted loan/collateral pairs
# are traded (USDC/DAI/USDT/WETH loans against WETH/WBTC/wstETH collateral).
# MORPHO_MARKET_CAP=24
# MORPHO_BORROWER_CAP=64

# Maker ilks from the built-in table: ETH-A, WBTC-A, WSTETH-A. Default ETH-A
# (biggest liquidation surface, one log scan). Comma separated to widen.
# MAKER_ILKS=ETH-A

# Chainlink proxy:collateral pairs whose updates are back-run. Defaults cover
# the two dominant collateral feeds. The aggregator behind each proxy is
# resolved on chain at runtime.
# ORACLE_WATCH_FEEDS=0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419:0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2,0xF4030086522a5bEEa4988F8cA5B36dbC97BeE88c:0x2260FAC5E5542a773Aa44fBCfeDf7C193bc2C599

# Near-miss leads converted into simulations per oracle update.
# ORACLE_FRONTRUN_MAX_LEADS=3

# Decode Uniswap UniversalRouter `execute` calldata (V2_SWAP_EXACT_IN /
# V3_SWAP_EXACT_IN) and feed the resulting SwapIntent to sandwich / arb.
# Off by default — Phase 2 W6 is gated on a week of funnel data showing a
# public-mempool gap. Pure calldata parsing; no RPC of its own.
# DECODE_UNIVERSAL_ROUTER=false

# ─────────────────────────────────────────────────────────────────────────────
# POOL DISCOVERY
# ─────────────────────────────────────────────────────────────────────────────

# V2 pool discovery: scan PairCreated on UniV2/SushiV2 factories each block and
# load WETH-quoted, non-dust pools into the cache. On by default.
# POOL_DISCOVERY=true

# V3 pool discovery: scan PoolCreated on the UniswapV3 factory and cache
# WETH-quoted pools on the 0.05% / 0.30% / 1.00% fee tiers. On together
# with STRATEGY_SANDWICH_V3 — they are a pair. V3 pools are held in a
# cache of their own; they are never mixed into the V2 cache.
# POOL_DISCOVERY_V3=true

# Longest cycle the atomic-arb search will consider, in legs (2-5).
#
# 3 is the default after the funnel-week baseline. 2 reproduces the original
# pair-to-pair search exactly. Raise to 4–5 only if live
# atomic_arb.candidatesEmitted on the same feed moved at 3: each extra leg
# costs ~120k gas (a 5-leg cycle is ~680k, which at BRIBE_BPS=9000 needs
# roughly 10x the gross profit of a 2-leg cycle to clear the net gate). The
# enumerator caps itself at 5 legs, 200 pools, 32 candidates and a 25 ms
# wall-clock budget per block regardless of what is set here.
# ARB_MAX_CYCLE_LEN=3

# ─────────────────────────────────────────────────────────────────────────────
# SIMULATION
# ─────────────────────────────────────────────────────────────────────────────

ANVIL_BIN=anvil
ANVIL_PORT=8548
REFORK_EVERY_BLOCKS=1
USE_CALL_BUNDLE=true
TARGET_BLOCK_OFFSET=1
SIM_TIMEOUT_MS=2500

# ─────────────────────────────────────────────────────────────────────────────
# API / STORAGE
# ─────────────────────────────────────────────────────────────────────────────

API_BIND=0.0.0.0:8080
DB_PATH=data/mev.sqlite
RUST_LOG=info,mev_bot=debug

# ─────────────────────────────────────────────────────────────────────────────
# EXECUTION MODE — leave these alone.
# Broadcasting requires BOTH of the following. The default build never sends.
# ─────────────────────────────────────────────────────────────────────────────

LIVE_EXECUTION=false
I_UNDERSTAND_LIVE_RISK=no

# Gate opportunities on the searcher's on-chain ETH+WETH balance. Off by
# default: the dummy SEARCHER_ADDRESS has no mainnet inventory, and turning
# this on would silence the tape. Forced on when live execution is enabled.
# INVENTORY_GATE=false

# ─────────────────────────────────────────────────────────────────────────────
# DASHBOARD (frontend/.env.local)
# ─────────────────────────────────────────────────────────────────────────────

BOT_API_URL=http://127.0.0.1:8080
# Optional: read-only RPC the browser uses for contract reads.
NEXT_PUBLIC_RPC_URL=
# Server-side RPC used by the dashboard's read-only /api/eth proxy (executor
# reads). Falls back to NEXT_PUBLIC_RPC_URL, then to a keyless public
# endpoint. Setting it to the bot's own ETH_HTTP_URL keeps one provider.
ETH_PROXY_URL=
