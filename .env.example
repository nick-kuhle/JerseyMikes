# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# Archive-capable Ethereum mainnet RPC (Alchemy / QuickNode / Erigon / Reth …).
# Needs eth_call at historical blocks and, ideally, eth_getRawTransactionByHash.
ETH_HTTP_URL=

# Websocket endpoint for newHeads + newPendingTransactions.
# Without it the bot falls back to HTTP head polling and sees no mempool.
ETH_WS_URL=

# ─────────────────────────────────────────────────────────────────────────────
# DATA SOURCES (all optional — the bot degrades gracefully)
# ─────────────────────────────────────────────────────────────────────────────

MEV_SHARE_SSE_URL=https://mev-share.flashbots.net
FLASHBOTS_RELAY_URL=https://relay.flashbots.net
RELAY_DATA_URLS=https://boost-relay.flashbots.net,https://bloxroute.max-profit.blxrbdn.com,https://agnostic-relay.net

# Extra mempool websockets (bloXroute, Blocknative, your own node…), comma separated.
EXTRA_MEMPOOL_WS=

# bloXroute Max Profit relay: pull each delivered block's transactions and score
# them for extractable value. Read-only (polls a public data API + your RPC).
BLOXROUTE_MAX_PROFIT_URL=https://bloxroute.max-profit.blxrbdn.com
RELAY_TX_INGEST=true

# L2 sequencer / preconfirmation feed. Used when chain #2 lands.
SEQUENCER_FEED_URL=

# Searcher identity for Flashbots. Only used to sign the X-Flashbots-Signature
# header on read-only eth_callBundle requests — it never needs funds.
FLASHBOTS_SIGNER_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# CHAIN
# ─────────────────────────────────────────────────────────────────────────────

CHAIN_ID=1
CHAIN_NAME=ethereum
BLOCK_TIME_MS=12000
WETH_ADDRESS=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
USD_STABLE_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# ─────────────────────────────────────────────────────────────────────────────
# CONTRACTS
# ─────────────────────────────────────────────────────────────────────────────

# Deployed MevExecutor. Leave empty to have the simulator inject the bytecode
# into its anvil fork at 0x…0e0000 (no deployment required to simulate).
EXECUTOR_ADDRESS=
SEARCHER_ADDRESS=0x00000000000000000000000000000000000f0000

# Only needed for `forge script script/Deploy.s.sol --broadcast`.
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# RISK — deliberately liberal to start. Tighten once the data says what works.
# ─────────────────────────────────────────────────────────────────────────────

# 1 wei == "record anything that is not a loss".
MIN_NET_PROFIT_WEI=1
# 100 ETH of notional per bundle.
MAX_POSITION_WEI=100000000000000000000
MAX_BASE_FEE_WEI=500000000000
# Share of gross profit paid to the builder (90%).
BRIBE_BPS=9000
MAX_GAS_PER_BUNDLE=3000000
# 0 disables the cumulative-drawdown kill switch.
MAX_DRAWDOWN_WEI=0
MAX_INFLIGHT_PER_STRATEGY=32

# ─────────────────────────────────────────────────────────────────────────────
# STRATEGIES
# ─────────────────────────────────────────────────────────────────────────────

STRATEGY_SANDWICH=true
STRATEGY_JIT=true
STRATEGY_ATOMIC_ARB=true
STRATEGY_LIQUIDATION=true
STRATEGY_SNIPER=true

# ─────────────────────────────────────────────────────────────────────────────
# V2 POOL DISCOVERY
# ─────────────────────────────────────────────────────────────────────────────

# V2 pool discovery: scan PairCreated on UniV2/SushiV2 factories each block and
# load WETH-quoted, non-dust pools into the cache. On by default.
# POOL_DISCOVERY=true

# ─────────────────────────────────────────────────────────────────────────────
# SIMULATION
# ─────────────────────────────────────────────────────────────────────────────

ANVIL_BIN=anvil
ANVIL_PORT=8548
REFORK_EVERY_BLOCKS=1
USE_CALL_BUNDLE=true
TARGET_BLOCK_OFFSET=1
SIM_TIMEOUT_MS=2500

# ─────────────────────────────────────────────────────────────────────────────
# API / STORAGE
# ─────────────────────────────────────────────────────────────────────────────

API_BIND=0.0.0.0:8080
DB_PATH=data/mev.sqlite
RUST_LOG=info,mev_bot=debug

# ─────────────────────────────────────────────────────────────────────────────
# EXECUTION MODE — leave these alone.
# Broadcasting requires BOTH of the following. The default build never sends.
# ─────────────────────────────────────────────────────────────────────────────

LIVE_EXECUTION=false
I_UNDERSTAND_LIVE_RISK=no

# ─────────────────────────────────────────────────────────────────────────────
# DASHBOARD (frontend/.env.local)
# ─────────────────────────────────────────────────────────────────────────────

BOT_API_URL=http://127.0.0.1:8080
# Optional: read-only RPC the browser uses for contract reads.
NEXT_PUBLIC_RPC_URL=
